# ══════════════════════════════════════════════════════════════
# Predict Now — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── Canton/Zoro Wallet API ──────────────────────────────────
ZORO_BASE_URL=https://dev-api.zorowallet.com
ZORO_API_KEY=your_zoro_api_key

# Token config
INSTRUMENT_ID=CBTC
INSTRUMENT_ADMIN=canton_network_cbtc_admin_party_id

# ── Pool Wallet (Legacy / Default) ─────────────────────────
# Used as fallback if multi-pool vars not set
SENDER_PARTY_ID=your_pool_party_id
SENDER_PRIVATE_KEY=your_base64_ed25519_private_key
SENDER_PUBLIC_KEY=your_base64_ed25519_public_key

# ── Multi-Pool Wallets (Optional) ──────────────────────────
# Retail pool (for regular users)
POOL_RETAIL_PARTY_ID=
POOL_RETAIL_PRIVATE_KEY=
POOL_RETAIL_PUBLIC_KEY=

# Institutional pool 1
POOL_INST1_PARTY_ID=
POOL_INST1_PRIVATE_KEY=
POOL_INST1_PUBLIC_KEY=

# Institutional pool 2
POOL_INST2_PARTY_ID=
POOL_INST2_PRIVATE_KEY=
POOL_INST2_PUBLIC_KEY=

# Institutional pool 3
POOL_INST3_PARTY_ID=
POOL_INST3_PRIVATE_KEY=
POOL_INST3_PUBLIC_KEY=

# ── Firebase Admin SDK (Server-side) ───────────────────────
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ── Firebase Web SDK (Client-side, safe to expose) ─────────
FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=your_project_id

# ── Market Configuration ───────────────────────────────────
PORT=3000
DB_PATH=./market.db.json
ROUND_MINUTES=1
FEE_PERCENTAGE=0
CORS_ORIGIN=*

# Fee recipient (optional — only needed if FEE_PERCENTAGE > 0)
OPERATOR_PARTY_ID=

# ── Admin & Monitoring ─────────────────────────────────────
ADMIN_SECRET=your_admin_secret

# Slack alerts (optional)
SLACK_WEBHOOK_URL=

# CC View API (optional — for on-chain analytics)
CCVIEW_API_KEY=

# Rewards API key (for partner /api/rewards endpoint)
REWARDS_API_KEY=

# ── Agent Configuration (Optional) ─────────────────────────
AGENT_ENABLED=false
AGENT_POLL_MS=10000

# Agent wallet party IDs (from wallets-batch.json)
AGENT_PARTY_ID_1=
AGENT_PARTY_ID_2=
AGENT_PARTY_ID_3=

# Agent starting balance (CBTC, for fallback calculations)
AI_INITIAL_BALANCE=1.0

# ── Circuit Breaker (Gas Cost Protection) ──────────────────
# Minimum net margin (reward - gas) per txn in CC
CB_MIN_MARGIN=0.5

# Number of recent rounds to analyze
CB_LOOKBACK=10

# Auto-resume when margin recovers above 150% of threshold
CB_AUTO_RECOVER=true

# Expected CC reward per transaction (from Activity Tracker)
CB_REWARD_PER_TX=3.45

# ── Developer Options ──────────────────────────────────────
# Log all Canton API requests/responses
LOG_API_CALLS=false
